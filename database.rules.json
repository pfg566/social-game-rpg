              ".write": "auth != null && auth.uid == $uid && (auth.token.email.beginsWith($cid + '-') || (auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'pfg566@gmail.com' || root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true)))",
              ".validate": "newData.hasChildren(['name','job'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 12"
              },
              "job": {
                ".validate": "newData.val() == 'knight' || newData.val() == 'archer' || newData.val() == 'mage'"
              }
            }
          }
        }
      }
    },
    "partyLive": {
      "$rid": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('host').val() == auth.uid || (auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'pfg566@gmail.com' || root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true)))",
        "host": {
          ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid) || data.val() == auth.uid)"
        },
        "g": {
          ".write": "auth != null && data.parent().child('host').val() == auth.uid"
        },
        "p": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "ev": {
          "$e": {
            ".write": "auth != null && (!data.exists() || data.parent().parent().child('host').val() == auth.uid)"
          }
        },
        "dm": {
          "$uid": {
            "$e": {
              ".write": "auth != null && (auth.uid == $uid || data.parent().parent().parent().child('host').val() == auth.uid)"
            }
          }
        }
      }
    }
  }
}